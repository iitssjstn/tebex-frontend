{
  "name": "tebex-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Database-driven Minecraft webshop for Tebex with a full browser-based admin panel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
